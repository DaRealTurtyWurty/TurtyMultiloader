    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/DaRealTurtyWurty/TurtyMultiloader",
        "issues": "https://github.com/DaRealTurtyWurty/TurtyMultiloader/issues",
        "sources": "https://github.com/DaRealTurtyWurty/TurtyMultiloader"
    },
    "license": "${license}",
    "environment": "*",
